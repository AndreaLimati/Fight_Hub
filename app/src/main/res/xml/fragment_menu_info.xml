<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 1. TRANSIZIONE PER INFO (Verticale) -->
    <Transition
        app:constraintSetStart="@+id/start"
        app:constraintSetEnd="@+id/end"
        app:duration="500">
        <OnSwipe
            app:touchAnchorId="@id/detailsScroll"
            app:touchAnchorSide="top"
            app:dragDirection="dragUp"
            app:moveWhenScrollAtTop="true" />
    </Transition>

    <!-- 2. TRANSIZIONE PER LIKE (Destra) -->
    <Transition
        app:constraintSetStart="@+id/start"
        app:constraintSetEnd="@+id/like"
        app:duration="400">
        <OnSwipe
            app:touchAnchorId="@id/profileCard"
            app:touchRegionId="@id/profileCard"
            app:dragDirection="dragRight"
            app:onTouchUp="autoComplete"
            app:dragScale="1.2" /> <!-- Aumenta la sensibilità dello swipe -->
    </Transition>

    <!-- 3. TRANSIZIONE PER PASS (Sinistra) -->
    <Transition
        app:constraintSetStart="@+id/start"
        app:constraintSetEnd="@+id/pass"
        app:duration="400">
        <OnSwipe
            app:touchAnchorId="@id/profileCard"
            app:touchRegionId="@id/profileCard"
            app:dragDirection="dragLeft"
            app:onTouchUp="autoComplete"
            app:dragScale="1.2" />
    </Transition>

    <ConstraintSet android:id="@+id/start">
        <!-- CRITICO: Nascondi fisicamente lo scroll quando sei in START -->
        <Constraint android:id="@id/detailsScroll">
            <PropertySet android:alpha="0" android:visibility="gone" />
        </Constraint>

        <Constraint android:id="@id/profileCard">
            <Layout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="16dp"
                app:layout_constraintBottom_toTopOf="@+id/actionsContainer"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </Constraint>
    </ConstraintSet>

    <ConstraintSet android:id="@+id/end">
        <Constraint android:id="@id/profileCard">
            <Layout
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_margin="0dp"
                app:layout_constraintTop_toTopOf="parent" />
        </Constraint>

        <Constraint android:id="@id/detailsScroll">
            <PropertySet android:alpha="1" android:visibility="visible" />
            <Layout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintTop_toBottomOf="@id/profileCard"
                app:layout_constraintBottom_toBottomOf="parent" />
        </Constraint>

        <Constraint android:id="@id/actionsContainer">
            <PropertySet android:alpha="0" />
            <Layout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="parent" />
        </Constraint>
    </ConstraintSet>

    <ConstraintSet android:id="@+id/like" app:deriveConstraintsFrom="@id/start">
        <Constraint android:id="@id/profileCard">
            <Layout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="500dp"
                app:layout_constraintStart_toEndOf="parent" />
            <Transform android:rotation="30" />
        </Constraint>
    </ConstraintSet>

    <ConstraintSet android:id="@+id/pass" app:deriveConstraintsFrom="@id/start">
        <Constraint android:id="@id/profileCard">
            <Layout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginEnd="500dp"
                app:layout_constraintEnd_toStartOf="parent" />
            <Transform android:rotation="-30" />
        </Constraint>
    </ConstraintSet>

</MotionScene>