        <shape android:shape="rectangle">
            <padding android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp" />
            <corners android:radius="30dp" />
            <solid android:color="#4DFF0000" /> </shape>
    </item>

    <item>
