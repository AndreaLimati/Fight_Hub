<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2C2B2B">

    <androidx.appcompat.widget.Toolbar
    android:id="@+id/toolbar"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    android:background="#2C2B2B"
        app:layout_constraintTop_toTopOf="parent">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Modifica Profilo"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnSave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="16dp"
        android:backgroundTint="#FF0000"
        android:text="SALVA"
        android:textColor="#FFFFFF" />
</androidx.appcompat.widget.Toolbar>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FOTO PROFILO (MAX 5)"
                android:textColor="#FF0000"
                android:textSize="12sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFoto"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="#333333" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DATI NON MODIFICABILI"
                android:textColor="#888888"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvNomeEtaModifica"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="Nome, Età (Contatta il supporto per modifiche)"
                android:textColor="#555555" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="#333333" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PESO (KG)"
                android:textColor="#FF0000"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPeso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#FF0000"
                android:hint="Es: 90"
                android:inputType="numberDecimal"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="SPORT PRATICATI"
                android:textColor="#FF0000"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgSports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnJudo"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/button_selector_artimarziali"
                        android:text="Judo"
                        android:textAllCaps="false"
                        android:textColor="#000000"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/btnKarate"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/button_selector_artimarziali"
                        android:text="Karate"
                        android:textAllCaps="false"
                        android:textColor="#000000"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/btnBoxe"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/button_selector_artimarziali"
                        android:text="Boxe"
                        android:textAllCaps="false"
                        android:textColor="#000000"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/btnMuayThai"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/button_selector_artimarziali"
                        android:text="Muay Thai"
                        android:textAllCaps="false"
                        android:textColor="#000000"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/btnMMA"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/button_selector_artimarziali"
                        android:text="MMA"
                        android:textAllCaps="false"
                        android:textColor="#000000"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/btnAltro"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/button_selector_artimarziali"
                        android:text="Altro..."
                        android:textAllCaps="false"
                        android:textColor="#000000"
                        app:backgroundTint="@null" />

                </LinearLayout>
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="DESCRIZIONE"
                android:textColor="#FF0000"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etBio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#FF0000"
                android:gravity="top"
                android:hint="Parlaci del tuo stile di combattimento..."
                android:inputType="textMultiLine"
                android:minLines="4"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>