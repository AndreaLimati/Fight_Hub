<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.motion.widget.MotionLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/motionLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layoutDescription="@xml/fragment_menu_info"
    android:background="#2C2B2B">

    <!-- 1. CORNICE PER L'EFFETTO GLOW -->
    <!-- Questa View sta dietro la card e crea il bagliore neon -->


    <View
        android:id="@+id/glowBorder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="14dp"
        android:background="@drawable/glow_neon_shape"
        app:layout_constraintBottom_toTopOf="@+id/actionsContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. LA CARD DEL PROFILO -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/profileCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@color/black"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp"
        app:strokeColor="#40FFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toTopOf="@+id/actionsContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/profileImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/chuck_norris" />

            <!-- Gradiente scuro interno per leggibilità testo -->
            <View
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:background="@drawable/bottom_gradient"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Indicatori stile Stories spostati dentro la card -->
            <LinearLayout
                android:id="@+id/indicatorContainer"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:weightSum="5"
                app:layout_constraintTop_toTopOf="parent">
                <!-- I tuoi View figli rimangono uguali -->
                <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginHorizontal="2dp" android:layout_weight="1" android:background="@color/white" />
                <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginHorizontal="2dp" android:layout_weight="1" android:background="#80FFFFFF" />
                <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginHorizontal="2dp" android:layout_weight="1" android:background="#80FFFFFF" />
                <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginHorizontal="2dp" android:layout_weight="1" android:background="#80FFFFFF" />
                <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginHorizontal="2dp" android:layout_weight="1" android:background="#80FFFFFF" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="8dp"
                android:text="Chuck 86"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@+id/txtBio"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/txtBio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="40dp"
                android:layout_marginBottom="16dp"
                android:text="Non sto cercando un 'match'.\nSto cercando qualcuno che sopravviva."
                android:textColor="#E0FFFFFF"
                android:textSize="14sp"
                app:layout_constraintBottom_toTopOf="@+id/tagContainer"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/txtName" />

            <LinearLayout
                android:id="@+id/tagContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@+id/txtName">
                <TextView
                    android:id="@+id/judo"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/tag_background"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="Judo"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/karate"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/tag_background"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="Karate"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/boxe"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/tag_background"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="Boxe"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/muaythai"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/tag_background"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="Muay Thai"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/mma"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/tag_background"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="MMA"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/altro"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/tag_background"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="Altro..."
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/imageButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/profileImage"
                app:layout_constraintHorizontal_bias="0.922"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/profileImage"
                app:layout_constraintVertical_bias="0.77"
                app:srcCompat="@android:drawable/ic_dialog_info" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>


    <!-- SECONDA PAGINA INFO -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/detailsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/black"
        android:alpha="0"
        app:layout_constraintTop_toBottomOf="@id/profileCard"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Informazioni Dettagliate"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"/>


            <TextView
                android:id="@+id/descrizioneAvanzata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="sus."
                android:textColor="#B0FFFFFF"
                android:layout_marginTop="10dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 3. AREA PULSANTI FLUTTUANTI -->
    <LinearLayout
        android:id="@+id/actionsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigation">

        <ImageButton
            android:id="@+id/btnNo"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_marginEnd="40dp"
            android:background="@drawable/circle_red"
            android:elevation="8dp"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close_white" />

        <ImageButton
            android:id="@+id/btnYes"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:background="@drawable/circle_green"
            android:elevation="8dp"
            android:padding="18dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_pugno_si" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/imageButton2"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:background="@drawable/circle_border_red"

        android:src="@drawable/ic_modifica_filtri"
        android:padding="12dp"
        android:scaleType="centerInside"

        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackgroundBorderless"

        app:layout_constraintTop_toTopOf="@+id/actionsContainer"
        app:layout_constraintBottom_toBottomOf="@+id/actionsContainer"

        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp" />

    <TextView
        android:id="@+id/txtLabelFiltra"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="filtra"
        android:textAllCaps="true"
        android:textColor="#99FFFFFF"
        android:textSize="9sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginTop="6dp"

        app:layout_constraintTop_toBottomOf="@+id/imageButton2"
        app:layout_constraintStart_toStartOf="@+id/imageButton2"
        app:layout_constraintEnd_toEndOf="@+id/imageButton2" />

    <!-- 4. NAVIGATION BAR TRASPARENTE -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@android:color/transparent"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chat          Fight          Profilo"
            android:textColor="#80FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.motion.widget.MotionLayout>