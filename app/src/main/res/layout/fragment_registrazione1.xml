<?xml version="1.0" encoding="utf-8"?>

    <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.cardview.widget.CardView
            android:layout_width="294dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            app:cardBackgroundColor="#212121"
            app:cardCornerRadius="32dp"
            app:cardElevation="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nome"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etNome"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/edittext_border_style"
                    android:hint="Inserisci nome"
                    android:inputType="textPersonName"
                    android:paddingStart="15dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#55FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cognome"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etCognome"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/edittext_border_style"
                    android:hint="Inserisci cognome"
                    android:textColorHint="#55FFFFFF"
                    android:paddingStart="15dp"
                    android:textColor="#FFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Data di nascita"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/SceltaData"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:backgroundTint="#F5F5F5"
                        android:text="Scegli"
                        android:textColor="#55000000"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Peso (kg)"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etPeso"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/edittext_border_style"
                            android:hint="Es: 75"
                            android:inputType="number"
                            android:paddingStart="15dp"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#55FFFFFF" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Altezza (cm)"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etAltezza"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/edittext_border_style"
                            android:hint="Es: 180"
                            android:inputType="number"
                            android:paddingStart="15dp"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#55FFFFFF" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Descrizione profilo"
                    android:textColor="#FFFFFF" />

                <EditText
                    android:id="@+id/etDescrizione"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/edittext_border_style"
                    android:hint="Dicci qualcosa su di te!"
                    android:textColorHint="#55FFFFFF"
                    android:gravity="top"
                    android:padding="12dp"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnInvia"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:backgroundTint="#F5F5F5"
                    android:text="Invia"
                    android:textColor="#1A1A1A"
                    app:cornerRadius="16dp" />

                <ProgressBar
                    android:id="@+id/stepProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="24dp"
                    android:progress="25"
                    android:progressTint="#FF0000" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>
