<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2C2B2B"
    android:padding="24dp">

    <!-- Foto Profilo con un tocco di Glow Rosso -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivProfilo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="20dp"
        android:scaleType="centerCrop"
        android:padding="2dp"
        android:src="@drawable/icona_profilo_navbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/CircleImage"
        app:strokeColor="#FF0000"
        app:strokeWidth="3dp" />

    <!-- Nome e Età -->
    <TextView
        android:id="@+id/tvNomeEta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Andrea, 21"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:fontFamily="sans-serif-black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivProfilo" />

    <!-- Dati tecnici piccoli e eleganti -->
    <TextView
        android:id="@+id/tvPesoAltezza"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="90 KG  •  180 CM"
        android:textColor="#666666"
        android:textSize="14sp"
        android:letterSpacing="0.1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvNomeEta" />

    <!-- Due bottoni d'azione principali (Stile Outlined) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnModifica"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="8dp"
        android:text="MODIFICA"
        android:textColor="#FFFFFF"
        app:strokeColor="#FF0000"
        app:cornerRadius="12dp"
        app:layout_constraintEnd_toStartOf="@+id/btnStatistiche"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPesoAltezza" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStatistiche"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:backgroundTint="#FF0000"
        android:text="STATISTICHE"
        android:textColor="#FFFFFF"
        app:cornerRadius="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btnModifica"
        app:layout_constraintTop_toTopOf="@id/btnModifica" />

    <TextView
        android:id="@+id/tvRecensioniTitolo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="RECENSIONI"
        android:textColor="#FF0000"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnModifica" />

    <!-- Lista recensioni senza Card esterna, più pulita -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRecensioni"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvRecensioniTitolo" />

    <ImageView
        android:id="@+id/LogOut"
        android:layout_width="39dp"
        android:layout_height="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/logout"
        android:foreground="?android:attr/selectableItemBackgroundBorderless"/>

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Log Out"
        android:textColor="#FF0000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.054" />

</androidx.constraintlayout.widget.ConstraintLayout>